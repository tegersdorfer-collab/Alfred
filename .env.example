# Kopiere diese Datei zu .env und trage deine echten Werte ein.

# LLM (lokal via Ollama)
OLLAMA_MODEL=qwen3:14b
OLLAMA_FAST_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_KEEP_ALIVE=30m

# Claude (optional, für schwere Aufgaben)
ANTHROPIC_API_KEY=

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Besitzer (persönliche Daten – bleiben lokal)
OWNER_NAME=DeinName
OWNER_EMAIL=
OWNER_TIMEZONE=Europe/Berlin

# Datenbank (PostgreSQL + pgvector)
DATABASE_URL=postgresql://localhost:5432/jarvis

# Thermal
THERMAL_TARGET_CELSIUS=70.0
THERMAL_MAX_CELSIUS=85.0

# Web-Suche (optional)
BRAVE_API_KEY=
