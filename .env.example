# Kopiere diese Datei zu .env und trage deine echten Werte ein.

# LLM (lokal via Ollama) – Modell bequem wechseln mit: ./switch.sh 4b | 3.5 | 8b | 14b
OLLAMA_MODEL=qwen3:14b
OLLAMA_FAST_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_KEEP_ALIVE=30m

# Auto-Routing: schnell wenn möglich (4B), stark wenn nötig (9B). ./switch.sh route on|off
LLM_ROUTING=true
AGENT_MODEL_FAST=qwen3.5:4b
AGENT_MODEL_STRONG=qwen3.5:9b
OLLAMA_KEEP_ALIVE_STRONG=2m      # starkes Modell schnell entladen (schont 16-GB-RAM)

# Claude (optional, für schwere Aufgaben)
ANTHROPIC_API_KEY=

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: weitere autorisierte Telegram-IDs (kommagetrennt).
# TELEGRAM_CHAT_ID ist immer erlaubt; nur gelistete IDs dürfen mit Alfred reden.
TELEGRAM_ALLOWED_IDS=

# Besitzer (persönliche Daten – bleiben lokal)
OWNER_NAME=DeinName
OWNER_EMAIL=
OWNER_TIMEZONE=Europe/Berlin

# Datenquellen (direkt von der Quelle)
HEALTH_JSON_PATH=~/Library/Mobile Documents/iCloud~is~workflow~my~workflows/Documents/Health.json
CALENDAR_ICS_URLS=          # kommagetrennte ICS-Abo-URLs (Google/iCloud Kalender)

# Datenbank (PostgreSQL + pgvector)
DATABASE_URL=postgresql://localhost:5432/alfred

# Thermal
THERMAL_TARGET_CELSIUS=70.0
THERMAL_MAX_CELSIUS=85.0

# Web-Suche (optional)
BRAVE_API_KEY=
